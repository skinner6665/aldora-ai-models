# Aldora AI Models — variáveis de ambiente
# Copie para .env e preencha os valores reais

# ── Obrigatório ───────────────────────────────────────────────────────────────
# Claude Vision API — usado pelo Pill Identifier (/v1/pill)
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Opcional ──────────────────────────────────────────────────────────────────
# HuggingFace token (para modelos com acesso restrito)
HUGGINGFACE_TOKEN=hf_...

# Caminhos para checkpoints treinados (fine-tuned)
# Se não existirem, os modelos usam pesos pré-treinados (ImageNet) ou modo demo
DERMA_WEIGHTS_PATH=checkpoints/derma_efficientnet_b4.pth
SEPSE_MODEL_PATH=checkpoints/sepse_xgb.json
